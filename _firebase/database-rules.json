{
  "rules": {
    "rooms": {
      ".read": false,
      "$room": {
        ".read": true,
        ".write": "$room.length <= 32 && $room.matches(/^[a-zA-Z0-9_-]+$/)",
        "content": {
          ".validate": "newData.isString() && newData.val().length < 1000000"
        },
        "image": {
          ".validate": "newData.isString() && newData.val().length < 700000"
        },
        "files": {
          "$fileId": {
            ".validate": "newData.hasChildren(['name', 'size', 'content', 'uploadedAt', 'uploadedBy'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "size": {
              ".validate": "newData.isNumber()"
            },
            "content": {
              ".validate": "newData.isString() && newData.val().length < 7500000"
            },
            "uploadedAt": {
              ".validate": "newData.isNumber()"
            },
            "uploadedBy": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "members": {
          "$member": {
            ".validate": "newData.hasChildren(['name', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "lastDisconnect": {
          ".validate": "newData.isNumber()"
        },
        "history": {
          "$msg": {
            ".validate": "$msg.length <= 24 && $msg.matches(/^[a-z0-9]+$/) && newData.hasChildren(['text','timestamp'])",
            "text": {
              ".validate": "newData.isString() && newData.val().length < 1000000"
            },
            "timestamp": {
              ".validate": "newData.isNumber()"
            },
            "sender": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "cleanup": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "pageviews": {
      ".read": true,
      "$key": {
        ".write": "$key.length <= 64 && $key.matches(/^[a-zA-Z0-9_-]+$/)",
        ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() + 1 : newData.val() === 1)"
      }
    },
    "chess": {
      "players": {
        ".read": true,
        ".indexOn": [
          "level"
        ],
        "$player": {
          ".write": "auth != null && $player.matches(/^[A-Z2-9]{12}$/) && (data.exists() || root.child('chess/devices/' + auth.uid).val() === $player)",
          ".validate": "newData.hasChildren(['name', 'updatedAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9][A-Za-z0-9 -]{0,19}$/) && (!data.exists() || data.val() === newData.val() || ((!data.parent().child('nameChangedAt').exists() || data.parent().child('nameChangedAt').val() < now - 604800000) && newData.parent().child('nameChangedAt').val() >= now - 600000 && newData.parent().child('nameChangedAt').val() <= now + 600000))"
          },
          "nameChangedAt": {
            ".validate": "newData.isNumber()"
          },
          "memStage": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "level": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4000"
          },
          "games": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "wins": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "draws": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "losses": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "bestWin": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "recent": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]$/) && newData.hasChildren(['t','bot','result'])",
              "t": {
                ".validate": "newData.isNumber()"
              },
              "bot": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              },
              "color": {
                ".validate": "newData.val() == 'w' || newData.val() == 'b'"
              },
              "result": {
                ".validate": "newData.isString() && newData.val().length <= 8"
              },
              "tc": {
                ".validate": "newData.isString() && newData.val().length <= 8"
              },
              "moves": {
                ".validate": "newData.isNumber()"
              },
              "perf": {
                "elo": {
                  ".validate": "newData.isNumber()"
                },
                "acpl": {
                  ".validate": "newData.isNumber()"
                },
                "n": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              },
              "pgn": {
                ".validate": "newData.isString() && newData.val().length <= 8000"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "deck": {
            "$pos": {
              ".validate": "$pos.length <= 24 && $pos.matches(/^[a-z0-9]+$/) && newData.hasChildren(['fen','best'])",
              "fen": {
                ".validate": "newData.isString() && newData.val().length <= 100"
              },
              "played": {
                ".validate": "newData.isString() && newData.val().length <= 10"
              },
              "best": {
                ".validate": "newData.isString() && newData.val().length <= 10"
              },
              "bestSan": {
                ".validate": "newData.isString() && newData.val().length <= 10"
              },
              "cls": {
                ".validate": "newData.isString() && newData.val().length <= 10"
              },
              "loss": {
                ".validate": "newData.isNumber()"
              },
              "t": {
                ".validate": "newData.isNumber()"
              },
              "due": {
                ".validate": "newData.isNumber()"
              },
              "ivl": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
              },
              "reps": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "lapses": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "bot": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              },
              "motif": {
                ".validate": "newData.isString() && newData.val().length <= 24"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "rep": {
            "$line": {
              ".validate": "$line.length <= 24 && $line.matches(/^[a-z0-9]+$/) && newData.hasChildren(['moves','color'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "color": {
                ".validate": "newData.val() == 'w' || newData.val() == 'b'"
              },
              "moves": {
                ".validate": "newData.isString() && newData.val().length <= 300"
              },
              "t": {
                ".validate": "newData.isNumber()"
              },
              "due": {
                ".validate": "newData.isNumber()"
              },
              "ivl": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
              },
              "reps": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "lapses": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "daily": {
            ".validate": "newData.hasChildren(['updatedAt'])",
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "done": {
              "$d": {
                ".validate": "$d.matches(/^[0-9]{1,4}$/) && newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
              }
            },
            "cur": {
              ".validate": "newData.hasChildren(['day','solved'])",
              "day": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000"
              },
              "solved": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "devices": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z2-9]{12}$/) && (!data.exists() || newData.val() === data.val())"
        }
      },
      "positions": {
        ".read": true,
        "$pos": {
          ".write": "auth != null && $pos.length <= 100 && $pos.matches(/^[a-zA-Z0-9_-]+$/)",
          ".validate": "newData.hasChildren(['d','cp','bm','n','t'])",
          "d": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60 && (!data.exists() || newData.val() >= data.val())"
          },
          "cp": {
            ".validate": "newData.isNumber() && newData.val() >= -32000 && newData.val() <= 32000"
          },
          "bm": {
            ".validate": "newData.isString() && newData.val().length <= 6"
          },
          "n": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}