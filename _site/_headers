# Stable worker URLs must revalidate rather than reuse a cached program.
/tools/messages
  Cache-Control: no-cache, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/tools/messages.html
  Cache-Control: no-cache, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/tools/messages-sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  Content-Type: application/javascript; charset=utf-8
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/tools/messages.webmanifest
  Cache-Control: no-cache, max-age=0, must-revalidate
  Content-Type: application/manifest+json
  X-Content-Type-Options: nosniff

# Private thesis shell and worker runtime.
/tools/thesis
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

/tools/thesis.html
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

/tools/thesis-tex-assets/worker.js
  Content-Security-Policy-Report-Only: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-cache
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
