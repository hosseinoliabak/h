%% expl3.sty -- local stub for this site's TeX tree.
%%
%% The engine's format file preloads the L3 programming layer (the banner
%% says "L3 programming layer <2020-02-14>"), so a package asking for expl3
%% already has it. The upstream loader refuses to run when its own date
%% differs from the preloaded kernel's, and no archived release matches
%% 2020-02-14 exactly, so this stub stands in and simply declares the layer
%% present. The backend file (l3backend-pdfmode.def) is loaded by the format
%% itself at \begin{document}.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{expl3}[2020/02/14 L3 programming layer (preloaded by the format)]
\endinput
